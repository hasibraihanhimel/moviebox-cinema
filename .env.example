# Public URL of the existing FastAPI service. Leave blank for managed preview,
# where Vite proxies /backend to the local FastAPI service.
VITE_API_BASE_URL=

# Backend deployment settings. Use the exact public frontend origin(s), comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set a stable high-entropy value in production so tokens survive worker restarts.
PROXY_SIGNING_SECRET=
# Playback signatures remain valid for six hours so paused and long films keep working.
PROXY_TOKEN_TTL_SECONDS=21600

# Set to false to remove the optional ad placements from the UI.
VITE_ENABLE_ADS=true

# Explicit smart-link opened only after the user clicks Watch Ad.
VITE_SMART_LINK_URL=https://auctionr.org/4/c69074fbf2990ba792cfbf352a8e12ff
VITE_ENABLE_PREPLAY_AD=true
VITE_AD_COUNTDOWN_SECONDS=3

# Optional responsive banner creative. Leave blank for no banner creative.
VITE_AD_BANNER_URL=
VITE_AD_BANNER_IMAGE_URL=
VITE_AD_BANNER_LABEL=Sponsored placement
